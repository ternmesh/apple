<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- For the release workflow: sign for the store with the team's certificate, which Apple
	     keeps, and send the build to App Store Connect instead of writing it out. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>75ULBHU3YJ</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- The workflow numbers the build. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
